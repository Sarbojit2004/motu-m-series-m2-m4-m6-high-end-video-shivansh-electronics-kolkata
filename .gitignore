# ---------------------------------------------------------------------------
# Project-specific overrides
# ---------------------------------------------------------------------------
# The bare "out" rule in the Next.js section above would ignore the delivered
# renders. Both reels are deliverables and must be committed.
!out/
out/*
!out/*.mp4
!out/*.wav
!out/*.png
!out/.keep

# Per-beat verification stills are derived (npm run qa). Regenerable, not shipped.
out/qa/

# Verification stills are derived. Regenerate with:  node scripts/stills.mjs <part>
stills/

# The two new build directories keep their own .gitignore for public/ and
# node_modules/. _shared/ IS committed: fonts, the five sound files reused from
# the MOTU AVB repository, and the music stems are all INPUTS, and a render must
# never depend on fetching them from elsewhere.

# public/img and public/audio are derived and fully regenerable:
#   python3 scripts/rebuild_media.py     (30 images from the repo's source files)
#   python3 scripts/gen_audio.py         (all SFX, the ambient bed, both music beds)
# Together they are ~20 MB of output with no information the recipes lack, so
# they are not committed. public/fonts IS committed — the vendored woff2 faces
# are inputs, not output, and a render must never depend on a network fetch.
public/img/
public/audio/
public/vo/*.mp3

# Frames extracted from a delivered render for auditing. Derived:
#   node scripts/frames_from_render.mjs <part> <file.mp4>
frames/
