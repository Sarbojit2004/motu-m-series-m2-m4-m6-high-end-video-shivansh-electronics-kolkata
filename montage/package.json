{
  "name": "motu-mseries-montage",
  "version": "1.0.0",
  "private": true,
  "description": "MOTU M-Series (M2/M4/M6) 90-second 4K portrait raw-asset montage reel for Shivansh Electronics, Kolkata.",
  "scripts": {
    "art": "python3 scripts/build_assets.py",
    "music": "node scripts/build_music.mjs",
    "bootstrap": "npm run art && npm run music",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "coverage": "node scripts/coverage.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render Montage out/motu-mseries-montage-4k.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2 --concurrency=3",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.507",
    "@remotion/cli": "4.0.507",
    "@remotion/media-utils": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
